{
  "name": "ticketbot-pro",
  "version": "4.4.4",
  "description": "Multi-Account Ticketing Control Panel",
  "author": "Nur Hossain",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "node-machine-id": "^1.1.12",
    "puppeteer": "^22.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.nurhossain.ticketbotapipro",
    "productName": "TicketBot API Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}